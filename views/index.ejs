<!doctype html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="En enkel AMA-chat om Anas."
    />
    <title>ama-bot</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/styles/style.css" />
  </head>
  <body>
    <main class="page-shell">
      <nav class="topbar" aria-label="Hovednavigation">
        <a class="brand" href="#top">AMA<span>.</span></a>
        <span class="nav-status"><i class="online-dot"></i> Online</span>
      </nav>

      <section class="chat-scene" id="top" aria-labelledby="ask-title">
        <div class="scene-heading">
          <p class="eyebrow"><span class="status-dot"></span> A-Boy</p>
          <h1 id="ask-title">Spørg<br /><em>løs.</em></h1>
        </div>

        <div class="phone" aria-label="Chat med Anas">
          <div class="phone-speaker"></div>
          <div class="phone-screen">
          <div class="chat-header">
            <img class="avatar" src="/assets/images/no g.png" alt="Anas" />
            <div>
              <strong>A-Boy</strong>
              <span><i class="online-dot"></i> Klar til at svare</span>
            </div>
          </div>
          <div class="chat-messages" aria-label="Eksempel på en samtale">
            <div class="message message-bot">
              <p>Hej! Hvad vil du gerne vide om mig?</p>
              <time class="chat-timestamp"><%= currentTime %></time>
            </div>
          <% for (const message of messages) { %>
            <article class="<%= message.type %>">
              <p><%= message.text %></p>
              <time class="chat-timestamp"><%= message.time %></time>
            </article>
          <% } %>
          </div>
        <form class="ask-form" method="POST" action="/ask">
      <%# Jeg sender brugerens spørgsmål til POST-routen, når formularen bliver sendt. %>
      <label class="sr-only" for="question">Stil dit spørgsmål her:</label>
      <input id="question" name="question" type="text" placeholder="Stil dit spørgsmål..." />
  <button type="submit">Send</button>
</form>

<% if (error) { %>
  <%# Jeg viser kun fejlteksten, når brugeren har sendt et tomt spørgsmål. %>
  <p role="alert"><%= error %></p>
<% } %>

<script>
  const chatMessages = document.querySelector(".chat-messages");
  chatMessages.scrollTop = chatMessages.scrollHeight;

  const answerParagraphs = document.querySelectorAll(".chat-messages .answer p");
  const latestAnswer = answerParagraphs[answerParagraphs.length - 1];

  if (latestAnswer) {
    // Jeg viser det seneste svar bogstav for bogstav for at give chatten en skriveeffekt.
    const answerText = latestAnswer.textContent;
    let characterIndex = 0;
    latestAnswer.textContent = "";
    latestAnswer.classList.add("typing");

    const typeAnswer = window.setInterval(() => {
      latestAnswer.textContent += answerText[characterIndex];
      characterIndex += 1;
      chatMessages.scrollTop = chatMessages.scrollHeight;

      if (characterIndex >= answerText.length) {
        window.clearInterval(typeAnswer);
        latestAnswer.classList.remove("typing");
      }
    }, 36);
  }
</script>

          </div>
          <div class="gameboy-controls" aria-hidden="true">
            <div class="d-pad"><span></span></div>
            <div class="action-buttons"><b>B</b><b>A</b></div>
          </div>
          <div class="gameboy-label">AMA-BOY</div>
        </div>

      </section>

      <section class="stats-section" aria-labelledby="stats-title">
        <p class="eyebrow">Samtalestatistik</p>
        <h2 id="stats-title">Spørgsmål fordelt på emner</h2>
        <ul class="stats-list">
          <%# Jeg viser hver kategori og dens aktuelle tæller fra topicStats. %>
          <li><span>Navn</span><strong><%= topicStats.navn %></strong></li>
          <li><span>Bosted</span><strong><%= topicStats.bosted %></strong></li>
          <li><span>Fritid</span><strong><%= topicStats.fritid %></strong></li>
          <li><span>Alder</span><strong><%= topicStats.alder %></strong></li>
        </ul>
      </section>

      <footer class="footer">
        <span>© 2026 Anas
        </span>
      </footer>
    </main>
  </body>
</html>